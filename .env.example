RELAY_MODE=live
RELAY_SEED=0
RELAY_AUTH_TOKENS=replace-with-random-operator-token:relay-operator:operator
# Optional: issue intake is Devin's own GitHub connection (github:issues automation).
# Relay's webhook never enrolls issues; it only adds comment/PR/review events.
GITHUB_WEBHOOK_SECRET=replace-with-random-webhook-secret
GITHUB_TOKEN=replace-with-minimally-scoped-github-token
GITHUB_DEFAULT_BRANCH=master
# Controller gate: the allowed repository is fixed to exloong/superset in code.
# Label that fires the reproduction automation (label.name condition) and that
# the worker re-checks before adopting a session; defaults to `bug`.
RELAY_TRUSTED_LABEL=bug
# Optional: comma-separated GitHub logins allowed to trigger enrollment.
RELAY_TRUSTED_ACTORS=
# Devin service-user key (used by the worker to manage Devin Automations, poll their sessions,
# dispatch owner-authorized fixes, and by
# the API to proxy automation management). Needs ManageOrgAutomations,
# ViewOrgAutomations and ViewOrgSessions. Never sent to the browser.
DEVIN_API_TOKEN=replace-with-devin-api-token
DEVIN_ORG_ID=org-replace-with-your-organization-id
DEVIN_REVIEW_TOKEN=
APP_PORT=4173
